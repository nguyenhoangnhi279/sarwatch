  <tag k="note:vi" v="Quốc lộ 1 là tên chính thức của con đường này, theo Quyết định số 1454/QĐ-TTg ngày 1 tháng 9 năm 2021 của Thủ tướng Chính phủ Việt Nam. Đề nghị không sửa tên thành &quot;Quốc lộ 1A&quot;."/>
  <tag k="ref" v="QL.1"/>
  <tag k="source" v="Bing"/>
  <tag k="surface" v="asphalt"/>
 </way>
